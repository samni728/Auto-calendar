# Local application
APP_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
SESSION_COOKIE_SECURE=false
SYNC_INTERVAL_MINUTES=15
# Optional source-code mode overrides (scripts/manage-source.sh)
SOURCE_API_PORT=8000
SOURCE_WEB_PORT=8080
# Empty means source mode uses its own local SQLite database.
SOURCE_DATABASE_URL=
INITIAL_ADMIN_EMAIL=admin@autocalendar.app
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
APP_ENCRYPTION_KEY=replace-with-a-fernet-key

# PostgreSQL
POSTGRES_DB=autocalendar
POSTGRES_USER=autocalendar
POSTGRES_PASSWORD=replace-with-a-random-password

# Google OAuth Web Application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra Web Application
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Optional Cloudflare Tunnel (docker compose --profile cloudflare up -d)
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TUNNEL_DOMAIN=
